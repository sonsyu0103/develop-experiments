# go-api の環境変数。
# compose 経由で起動する場合は compose.yaml で設定済みなので、
# このファイルはローカルで `go run ./cmd/api` する場合に使う。
#
#   cp .env.example .env   # .env は .gitignore 済み

# --- 必須 -------------------------------------------------------------------

# PostgreSQL への接続文字列。これが無いと起動時にエラーで落ちる。
# compose の外から繋ぐのでホストは localhost。
DATABASE_URL=postgres://app:password@localhost:5432/bbs?sslmode=disable

# --- 任意 (以下は既定値) ----------------------------------------------------

# HTTP サーバの待ち受けアドレス
ADDR=:8080

# development のとき gin が DebugMode になり、ログがテキスト形式になる
ENV=development

# 接続プールの上下限。
#
# **DB のコア数に対して決める値。** 既定の 8 は 4 vCPU での実測から
# (docs/adr/0009-scaling-strategy.md の「実測」3-2)。
# 上限を増やしてもスループットは伸びず、遅い側の応答だけが悪化する。
#
# N+1 版のベンチマークで「並列度を上げても速くならない」現象を再現したいときは、
# DB_MAX_CONNS を並列度より小さくする (make nplus1-probe は
# BENCH_MAX_CONNS で別に振るので、こちらを変えなくてよい)。
DB_MAX_CONNS=8
DB_MIN_CONNS=2

# グレースフルシャットダウンの猶予秒数
SHUTDOWN_TIMEOUT_SECONDS=10

# CORS で許可するオリジン (カンマ区切り)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 認証 (Google OIDC) ------------------------------------------------------
# 揃っていない場合、API は起動するが **ログインの 2 経路だけ** が 503 を返す
# (GET /auth/google と そのコールバック)。
# 掲示板の閲覧と匿名投稿は認証に依存しないため、全体は落とさない。
#
# 発行済みセッションの検証・/me・ログアウトは、設定が無くても動く。
# セッションを引いて期限を見るだけで Google を必要としないため
# (docs/adr/0005-authentication.md 決定 4)。
#
# **この値を空にしても、ログイン中の利用者は止まらない。**
# 止まるのは新規ログインだけ。失効させるには sessions の行を消す:
#   DELETE FROM sessions WHERE user_id = $1;   特定の利用者
#   DELETE FROM sessions;                      全員 (インシデント時)
#
# 値は Google Cloud のコンソールで OAuth 2.0 クライアント ID を作って取得する。
# シークレットなので、このファイル (.env) は .gitignore 済み。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud 側の「承認済みのリダイレクト URI」と一致している必要がある
AUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ログイン完了後に戻す先
AUTH_FRONTEND_URL=http://localhost:3000

# 最初の管理者にする Google の sub (docs/adr/0011-moderation.md 決定 1)。
#
# UI から管理者を作れないようにするための設定。
# 「最初の 1 人」を作る機能は、そのまま「誰でも管理者になれる」機能になりうる。
# ここに書いた sub の利用者がログインしたときだけ admin へ昇格する。
#
# 自分の sub は、一度ログインしてから DB を見れば分かる:
#   SELECT google_sub FROM users WHERE email = '...';
BOOTSTRAP_ADMIN_GOOGLE_SUB=

# --- 問い合わせメール (docs/adr/0008-contact-and-mail.md) --------------------
# 揃っていない場合、**問い合わせの受付は動き、送信ワーカーだけが登録されない。**
#
# 認証や画像のように「経路ごと 503」にはしない。受け付けた問い合わせは
# contact_messages に残り、設定を入れたあとの周回で送られる (決定 1) ——
# 503 で断ると、その間に来た問い合わせがそのまま失われる。
#
# compose では mailpit を立ててあるので、ブラウザで受信内容を確認できる:
#   http://localhost:8025
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025

# SMTP 認証。**空なら認証しない** (Mailpit は要求しない)。
# 本番 (SES) では必要になる。
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# STARTTLS。**本番では必ず true にする。**
# 既定を false にしてあるのは Mailpit が平文で受けるため。
MAIL_SMTP_STARTTLS=false

# 差出人と宛先。**どちらもこちら側の固定値。**
# 利用者が入力したアドレスはヘッダに入らず、本文中のテキストになる
# (決定 2: 自動返信を送らない / 決定 3: ヘッダにユーザー入力を入れない)。
MAIL_FROM=no-reply@bbs.example.com
MAIL_TO=ops@bbs.example.com

# SMTP の接続と往復の上限秒数。
# 応答しないサーバに当たったとき、シャットダウンごと止まらないために要る。
MAIL_TIMEOUT_SECONDS=10

# 送信ワーカーを回す間隔。**短くしても送信は速くならない** ——
# 決めているのは SMTP の往復で、ここは「溜まった行に気づく頻度」。
CONTACT_DISPATCH_INTERVAL_SECONDS=60

# レート制限 (決定 4 のスパム対策)。同一 IP から窓あたり何件まで許すか。
# **無効にする設定は無い。** 0 は受け付けない (config が起動時に落とす)。
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
CONTACT_RATE_LIMIT_MAX=5

# client_ip を保持する日数。**ログの保持期間と揃える**
# (docs/adr/0010-log-pipeline.md 決定 6 の 400 日)。
# 同じ IP がログ側にも出ているので、片方だけ短くしても消したことにならない。
CONTACT_IP_RETENTION_DAYS=400
