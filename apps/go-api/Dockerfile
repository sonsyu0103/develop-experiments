# syntax=docker/dockerfile:1

# =============================================================================
# base: 依存関係の解決までを共通化する
# =============================================================================
# **patch まで固定する。** 浮動タグ (golang:1.26-alpine) だと、手元や CD の
# ビルダーに残っている古い 1.26.x で本番のバイナリが作られうる。公式イメージは
# GOTOOLCHAIN=local なので go.mod の toolchain 行も効かず、警告も出ない
# (PR #71 のレビュー指摘)。CI の GO_VERSION・go.mod の toolchain と揃える
# —— make verify-go-version が突き合わせる。
FROM golang:1.26.11-alpine AS base

WORKDIR /app

# go.mod / go.sum だけ先にコピーすることで、
# ソースを変更しても依存のダウンロード層がキャッシュに残る。
COPY go.mod go.sum ./
RUN go mod download


# =============================================================================
# dev: compose から使う開発用ステージ
# =============================================================================
# ソースはボリュームマウントで差し込まれるので、ここでは COPY しない。
FROM base AS dev

# wget はコンテナのヘルスチェックで使う
RUN apk add --no-cache wget

EXPOSE 8080
CMD ["go", "run", "./cmd/api"]


# =============================================================================
# builder: 本番用バイナリのビルド
# =============================================================================
FROM base AS builder

COPY . .

# CGO を無効にして完全に静的リンクする。
# -trimpath はビルドマシンの絶対パスをバイナリから消す (再現性とサイズのため)。
# -s -w はデバッグ情報とシンボルテーブルを落としてサイズを縮める。
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/api \
    ./cmd/api


# =============================================================================
# prod: 実行専用の最小イメージ
# =============================================================================
# シェルもパッケージマネージャも入っていないので、
# 侵入されても攻撃者が使える道具がほとんどない。
FROM gcr.io/distroless/static-debian12:nonroot AS prod

COPY --from=builder /out/api /api

USER nonroot:nonroot
EXPOSE 8080

ENTRYPOINT ["/api"]
