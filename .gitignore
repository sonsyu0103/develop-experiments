# Node.js (Next.js) のノイズを遮断
node_modules/
.next/
out/
build/
*.tsbuildinfo

# Next が実行モードに応じて書き換えるため、コミットすると差分が延々と出る。
#   next dev   → import "./.next/dev/types/routes.d.ts"
#   next build → import "./.next/types/routes.d.ts"
# Next 公式はコミットを推奨しているが、ここだけ外す。
# next-env.d.ts と .next の両方が無い状態 (CI のクリーンチェックアウト相当) でも
# `npx tsc --noEmit` が通ることを実測して確認済み。
next-env.d.ts

# Playwright の実行成果物 (レポート・trace・スクリーンショット)。
# 落ちたときの調査には要るが、コミットするものではない。
playwright-report/
test-results/
blob-report/

# Go のバイナリやノイズを遮断
bin/
dist/
/apps/go-api/docs/
# カバレッジプロファイル
*.out

# OSが勝手に作る透明なファイル
.DS_Store
Thumbs.db

# 環境変数の秘密ファイル
# .env.example はコミットする (雛形なので)
.env
.env*.local
